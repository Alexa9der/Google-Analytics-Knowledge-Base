{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-frontmatter.schema.json",
  "title": "Report front matter",
  "type": "object",
  "required": ["id", "title", "research_question", "created_at", "as_of", "author", "status", "fact_ids", "evidence_ids", "concept_ids", "service_ids", "method", "limitations"],
  "properties": {
    "id": {"type": "string", "pattern": "^REPORT-[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "research_question": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date"},
    "as_of": {"type": "string", "format": "date"},
    "author": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "reviewed", "issued", "superseded", "archived"]},
    "fact_ids": {"$ref": "#/$defs/factIds"},
    "evidence_ids": {"$ref": "#/$defs/evidenceIds"},
    "concept_ids": {"$ref": "#/$defs/conceptIds"},
    "service_ids": {"$ref": "#/$defs/serviceIds"},
    "method": {"type": "string", "minLength": 1},
    "limitations": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "factIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FACT-[0-7][0-9A-HJKMNP-TV-Z]{25}$"}},
    "evidenceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^EVID-[0-7][0-9A-HJKMNP-TV-Z]{25}$"}},
    "conceptIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CONCEPT-[0-7][0-9A-HJKMNP-TV-Z]{25}$"}},
    "serviceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SERVICE-[0-7][0-9A-HJKMNP-TV-Z]{25}$"}}
  },
  "additionalProperties": false
}

